# Maintainer: JBetchGH <JBetchGH@users.noreply.github.com>
#
# Binary AUR package. Downloads the signed release artifacts directly
# from GitHub Releases — faster install, no Go toolchain required.
# Use the source `mtroamd` package if you'd rather build from
# verified source.
#
# Per-arch sources are matched at install time by makepkg; the
# sha256sums_<arch> arrays are regenerated by `make aur-prep` after
# every upstream tag.

pkgname=mtroamd-bin
pkgver=0.3.1
pkgrel=1
pkgdesc="Persistent terminal daemon over QUIC — mosh+tmux in one daemon, with multi-client handoff (pre-built)"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/AG-Studio-Apps/mtroamd"
license=('AGPL-3.0-or-later')
conflicts=('mtroamd')
provides=("mtroamd=${pkgver}" "mtroam=${pkgver}")

_releaseurl="https://github.com/AG-Studio-Apps/mtroamd/releases/download/v${pkgver}"

source_x86_64=(
    "${_releaseurl}/mtroamd-linux-amd64"
    "${_releaseurl}/mtroam-linux-amd64"
    "${_releaseurl}/SHA256SUMS"
    "${_releaseurl}/SHA256SUMS.minisig"
    "${_releaseurl}/mtroamd.8"
    "${_releaseurl}/mtroam.1"
    "${_releaseurl}/mtroamd.bash"
    "${_releaseurl}/mtroam.bash"
    "${_releaseurl}/mtroamd.zsh"
    "${_releaseurl}/mtroam.zsh"
    "${_releaseurl}/mtroamd.fish"
    "${_releaseurl}/mtroam.fish"
)
source_aarch64=(
    "${_releaseurl}/mtroamd-linux-arm64"
    "${_releaseurl}/mtroam-linux-arm64"
    "${_releaseurl}/SHA256SUMS"
    "${_releaseurl}/SHA256SUMS.minisig"
    "${_releaseurl}/mtroamd.8"
    "${_releaseurl}/mtroam.1"
    "${_releaseurl}/mtroamd.bash"
    "${_releaseurl}/mtroam.bash"
    "${_releaseurl}/mtroamd.zsh"
    "${_releaseurl}/mtroam.zsh"
    "${_releaseurl}/mtroamd.fish"
    "${_releaseurl}/mtroam.fish"
)
source_armv7h=(
    "${_releaseurl}/mtroamd-linux-armv7"
    "${_releaseurl}/mtroam-linux-armv7"
    "${_releaseurl}/SHA256SUMS"
    "${_releaseurl}/SHA256SUMS.minisig"
    "${_releaseurl}/mtroamd.8"
    "${_releaseurl}/mtroam.1"
    "${_releaseurl}/mtroamd.bash"
    "${_releaseurl}/mtroam.bash"
    "${_releaseurl}/mtroamd.zsh"
    "${_releaseurl}/mtroam.zsh"
    "${_releaseurl}/mtroamd.fish"
    "${_releaseurl}/mtroam.fish"
)

# Placeholder sums; `make aur-prep` rewrites these from the published
# SHA256SUMS after every upstream release. Do NOT publish the
# PKGBUILD with SKIP — defeats the point of per-arch hashes.
sha256sums_x86_64=(
    'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
)
sha256sums_aarch64=(
    'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
)
sha256sums_armv7h=(
    'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
)

# Optional but recommended: minisign-verify the signed manifest
# before makepkg trusts any of these files. Users with `minisign`
# installed can run `minisign -V -p docs/release-public-key.txt -m
# SHA256SUMS` against the public key shipped in the upstream repo.

prepare() {
    case "$CARCH" in
        x86_64)  _arch=linux-amd64 ;;
        aarch64) _arch=linux-arm64 ;;
        armv7h)  _arch=linux-armv7 ;;
    esac
    # Match the upstream binary name (no -linux-* suffix once installed).
    cp "${srcdir}/mtroamd-${_arch}" "${srcdir}/mtroamd"
    cp "${srcdir}/mtroam-${_arch}"     "${srcdir}/mtroam"
}

package() {
    install -Dm755 "${srcdir}/mtroamd" "${pkgdir}/usr/bin/mtroamd"
    install -Dm755 "${srcdir}/mtroam"     "${pkgdir}/usr/bin/mtroam"

    # systemd-user unit, generated from the freshly-installed binary
    # so the file always matches `mtroamd unit print`. KillMode=
    # process is load-bearing for the v0.6+ sidecar architecture.
    chmod +x "${srcdir}/mtroamd"
    "${srcdir}/mtroamd" unit print --bin=/usr/bin/mtroamd > "${srcdir}/mtroamd.service"
    install -Dm644 "${srcdir}/mtroamd.service" "${pkgdir}/usr/lib/systemd/user/mtroamd.service"

    install -Dm644 "${srcdir}/mtroamd.8" "${pkgdir}/usr/share/man/man8/mtroamd.8"
    install -Dm644 "${srcdir}/mtroam.1"     "${pkgdir}/usr/share/man/man1/mtroam.1"

    install -Dm644 "${srcdir}/mtroamd.bash" "${pkgdir}/usr/share/bash-completion/completions/mtroamd"
    install -Dm644 "${srcdir}/mtroam.bash"     "${pkgdir}/usr/share/bash-completion/completions/mtroam"
    install -Dm644 "${srcdir}/mtroamd.zsh"  "${pkgdir}/usr/share/zsh/site-functions/_mtroamd"
    install -Dm644 "${srcdir}/mtroam.zsh"      "${pkgdir}/usr/share/zsh/site-functions/_mtroam"
    install -Dm644 "${srcdir}/mtroamd.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/mtroamd.fish"
    install -Dm644 "${srcdir}/mtroam.fish"     "${pkgdir}/usr/share/fish/vendor_completions.d/mtroam.fish"
}
