# Binaries — root-anchored so we don't accidentally ignore directories
# like cmd/mtroamd. The bare "mtroamd" pattern would match anywhere
# in the tree; "/mtroamd" matches only the build artifact at the root.
/mtroamd
/mtroamd-*
/mtroam
/mtroam-*
/dist/
/build/
/out/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local cert / state directories used during dev
.local-state/
testdata/keys/

# Private working areas — never published (gitignored recursively).
# Raw security scan/audit reports, working docs & plans, and debug
# captures live here. We periodically review .security/ and promote
# FIXED findings into the public docs/security-improvements.md.
.security/
.notes/
.debug/

# Local adoption/download tracking (not for publication)
.adoption/
