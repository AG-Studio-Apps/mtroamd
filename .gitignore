# Binaries — root-anchored so we don't accidentally ignore directories
# like cmd/mtroamd. The bare "mtroamd" pattern would match anywhere
# in the tree; "/mtroamd" matches only the build artifact at the root.
/mtroamd
/mtroamd-*
/mtroam
/mtroam-*
/dist/
/build/
/out/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local cert / state directories used during dev
.local-state/
testdata/keys/

# Local review notes
/docs/security-review-local.md

/docs/pre-v1.4-codex-security-audit.md
/docs/1.4.2-codex-security-audit.md
